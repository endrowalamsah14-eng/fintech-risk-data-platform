{
  "name": "epocket-pg-shard1-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "plugin.name": "pgoutput",
    "database.hostname": "2.28.224.16",
    "database.port": "5431", 
    "database.user": "epocket_admin",
    "database.password": "epocket_password",
    "database.dbname": "epocket_ledger",
    "topic.prefix": "pg-shard1",
    "schema.include.list": "public",
    "table.include.list": "public.customers,public.payment_methods,public.bank_accounts,public.identities,public.customer_balances,public.payment_intents,public.setup_intents,public.charges,public.refunds,public.balance_transactions,public.payouts,public.products,public.prices,public.subscriptions,public.invoices,public.credit_notes,public.disputes,public.early_fraud_warnings,public.reviews,public.radar_scores,public.block_rules",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "transforms": "route",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "([^.]+)\\.([^.]+)\\.([^.]+)",
    "transforms.route.replacement": "epocket.transactions"
  }
}